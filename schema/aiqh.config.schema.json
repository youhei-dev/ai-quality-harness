{
  "$id": "https://github.com/youhei-dev/ai-quality-harness/schema/aiqh.config.schema.json",
  "title": "aiqh.config.jsonc",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "node",
            "python",
            "mixed",
            "other"
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "timeoutSec": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "lint",
              "typecheck",
              "unit",
              "build",
              "security",
              "dependency",
              "e2e",
              "custom"
            ]
          },
          "command": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "timeoutSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "command"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "project",
    "checks"
  ],
  "additionalProperties": false
}
