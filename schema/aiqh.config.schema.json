{
  "$id": "https://github.com/youhei-dev/ai-quality-harness/schema/aiqh.config.schema.json",
  "title": "aiqh.config.jsonc",
  "description": "Structural schema for aiqh.config.jsonc (editor completion and validation). The final validation is done by aiqh at run time: check names must be unique, at least one check must be required (defaults.required applies), and commands must not be blank.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "node",
            "python",
            "mixed",
            "other"
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "timeoutSec": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "lint",
              "typecheck",
              "unit",
              "build",
              "security",
              "dependency",
              "e2e",
              "custom"
            ]
          },
          "command": {
            "type": "string",
            "pattern": "\\S"
          },
          "cwd": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "timeoutSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "\\S"
              },
              "category": {
                "type": "string",
                "enum": [
                  "private-key",
                  "url-credential",
                  "bearer",
                  "basic",
                  "anthropic",
                  "openai",
                  "aws",
                  "github",
                  "slack",
                  "google",
                  "gitlab",
                  "jwt",
                  "key-value"
                ]
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              },
              "expires": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "envProbePaths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exampleEnvSuffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxLineBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "lineOverlapBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCarryBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "project",
    "checks"
  ],
  "additionalProperties": false
}
